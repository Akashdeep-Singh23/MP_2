# Server Settings
APP_NAME="Personalized AI Fitness System"
APP_ENV="development"
PORT=8000
HOST="127.0.0.1"
ALLOWED_HOSTS="localhost,127.0.0.1"

# CORS Settings (Explicit local frontend origins)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Supabase app configuration (the publishable key is safe for API calls; user JWTs enforce RLS)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<publishable-or-anon-key>"

# Optional: required only by direct-SQL validation and disposable integration-test tooling.
DATABASE_URL=""

# Optional: required by the one-time catalogue import script. Never expose this key to Vite.
SUPABASE_SERVICE_ROLE_KEY=""

# Machine Learning / Recommendation Thresholds
DEFAULT_TOP_K=5
DURATION_WARNING_THRESHOLD_MINUTES=10
